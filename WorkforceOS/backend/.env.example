# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Supabase (database + storage — no local PostgreSQL / DATABASE_URL needed)
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=workforceos-documents

# JWT Configuration
JWT_SECRET=r/H5BvRExbeNyZux7UjrVZH/2hjzHe0wkCFzOjmfR8m18lgzuZf2JdizCeEyeUkbZWjGfoLll7qxBDH3XjYo0Q==
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# # Email Configuration (future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@workforceos.com
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=WorkforceOS <noreply@workforceos.com>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Application
APP_NAME=WorkforceOS
APP_URL=http://localhost:5173


